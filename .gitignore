# Raw data — not tracked in version control
data/raw/

# Processed data — generated by pipeline
data/processed/

# Virtual environment
.venv/

# Python cache
__pycache__/
*.pyc
*.pyo

# PyCharm project files
.idea/

# Pipeline log — generated at runtime
pipeline.log

# Model outputs — generated by pipeline
outputs/figures/
outputs/reports/

# Jupyter auto-generated checkpoint files — created automatically when working
# in Jupyter notebooks. Not part of source code, safe to exclude.
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db